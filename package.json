{
  "name": "opencode-discord-presence",
  "version": "0.7.1",
  "description": "Discord Rich Presence plugin for OpenCode - Display your current AI agent, model, and status in Discord",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "discord",
    "rich-presence",
    "rpc",
    "claude",
    "ai",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Puri12/opencode-discord-presence"
  },
  "bugs": {
    "url": "https://github.com/Puri12/opencode-discord-presence/issues"
  },
  "homepage": "https://github.com/Puri12/opencode-discord-presence#readme",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@opencode-ai/plugin": "^1.1.47",
    "@types/bun": "^1.3.8",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3"
  }
}
